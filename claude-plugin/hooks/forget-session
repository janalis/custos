#!/bin/sh
# SessionEnd hook: forget the findings that analyse-edited-file reported in
# this session, and those of sessions that ended without this hook (a crash,
# a killed terminal) once they have been left untouched for 7 days.
command -v jq >/dev/null 2>&1 || exit 0
session=$(jq -r '.session_id // empty' 2>/dev/null) || exit 0
base=${TMPDIR:-/tmp}/custos-claude-$(id -u)
# Only ever delete inside a directory of the user's own.
{ [ -d "$base" ] && [ ! -L "$base" ]; } || exit 0
[ -n "$(find "$base" -prune -user "$(id -u)" ! -perm -020 ! -perm -002)" ] || exit 0
case $session in
    ''|*[!A-Za-z0-9_-]*) ;;
    *) rm -rf -- "${base:?}/$session" ;;
esac
find "$base" -path "$base/*" -prune -type d -mtime +7 -exec rm -rf -- {} + 2>/dev/null
exit 0
