#!/bin/sh
# SessionEnd hook: forget the findings the edit hook reported in this session,
# and those of sessions that ended without this hook (a crash, a killed
# terminal) once they have been left untouched for 7 days.
command -v jq >/dev/null 2>&1 || exit 0
# shellcheck source-path=SCRIPTDIR source=../scripts/session-state
. "$(dirname "$0")/../scripts/session-state"
session=$(jq -r '.session_id // empty' 2>/dev/null) || exit 0
# Only ever delete inside a directory of the user's own.
base=$(custos_state_base) || exit 0
if custos_session_ok "$session"; then rm -rf -- "${base:?}/$session"; fi
find "$base" -path "$base/*" -prune -type d -mtime +7 -exec rm -rf -- {} + 2>/dev/null
exit 0
