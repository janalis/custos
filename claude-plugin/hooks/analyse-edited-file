#!/bin/sh
# PostToolUse hook: after Claude edits a PHP file, run custos on that file and
# hand its findings back to Claude as additional context. Claude Code runs one
# language server per file extension, so this also works next to another PHP
# language server. It never blocks the edit: any failure exits 0 silently.
#
# The first edit of a file in a session reports all its findings; later edits
# report only the findings that were not there before. A finding is matched by
# its rule and message, without its position, since edits move lines.
#
# With CUSTOS_CROSS_FILE=1, it also analyses the whole project and reports the
# findings the edit added in other files, against the project's findings at
# the previous edit, or at the start of the session (hooks/record-project).
command -v jq >/dev/null 2>&1 || exit 0
here=$(dirname "$0")
# shellcheck source-path=SCRIPTDIR source=../scripts/session-state
. "$here/../scripts/session-state"
custos=$here/../scripts/custos

input=$(cat) || exit 0
file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null) || exit 0
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
session=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null) || exit 0
case $file in *.php) ;; *) exit 0 ;; esac
key=$(printf '%s' "$file" | cksum | tr ' ' -)
# custos finds the project root from the working directory, as on the CLI.
if [ -n "$cwd" ]; then
    cd "$cwd" 2>/dev/null || exit 0
    # Relative paths keep each finding line short.
    case $file in "$cwd"/*) file=${file#"$cwd"/} ;; esac
fi
[ -f "$file" ] || exit 0

# Findings come first; a blank line and the summary follow them.
# In a monorepo, the project of the edited file picks its Composer launcher.
findings=$(CUSTOS_LAUNCHER_FROM=$(dirname "$file") "$custos" analyse --fail-on never -- "$file" 2>/dev/null |
    sed '/^$/,$d') || exit 0

# Findings reported earlier in this session, kept in a private directory.
dir=
if custos_session_ok "$session" && base=$(custos_state_base) && mkdir -p "$base/$session" 2>/dev/null; then
    dir=$base/$session
fi
state=${dir:+$dir/$key}
earlier=0
if [ -n "$state" ] && [ -f "$state" ]; then
    # Keep the findings whose rule and message were not reported before,
    # counting repeats: two identical findings where there was one is new.
    new=$(printf '%s\n' "$findings" | awk -v prev="$state" '
        function strip(s) { if (match(s, /:[0-9]+:[0-9]+: /)) s = substr(s, RSTART + RLENGTH); return s }
        BEGIN { while ((getline line < prev) > 0) seen[line]++ }
        NF { k = strip($0); if (seen[k] > 0) { seen[k]--; next } print }')
    earlier=$(($(printf '%s\n' "$findings" | grep -c .) - $(printf '%s\n' "$new" | grep -c .)))
else
    new=$findings
fi
if [ -n "$state" ]; then
    printf '%s\n' "$findings" | awk 'NF { if (match($0, /:[0-9]+:[0-9]+: /)) print substr($0, RSTART + RLENGTH) }' \
        > "$state.tmp" 2>/dev/null && mv -f "$state.tmp" "$state" 2>/dev/null
fi

# Findings the edit added in other files, the same way, by path, rule and
# message. Without earlier project findings, this edit only records them.
others=
if [ "${CUSTOS_CROSS_FILE:-}" = 1 ] && [ -n "$dir" ] && current=$(custos_project_findings "$custos"); then
    project=$dir/project
    if [ -f "$project" ]; then
        others=$(printf '%s\n' "$current" | awk -F '\t' -v prev="$project" -v self="$file" '
            BEGIN { while ((getline line < prev) > 0) { split(line, f, "\t"); seen[f[1] "\t" f[2]]++ } }
            NF && $1 != self { k = $1 "\t" $2; if (seen[k] > 0) { seen[k]--; next } print $3 }')
    fi
    printf '%s\n' "$current" > "$project.tmp" 2>/dev/null && mv -f "$project.tmp" "$project" 2>/dev/null
fi
[ -n "$new" ] || [ -n "$others" ] || exit 0

# Claude Code cuts hook context above 10,000 characters to a short preview:
# send at most 40 findings of at most 200 characters each.
max=40
nnew=0; [ -z "$new" ] || nnew=$(printf '%s\n' "$new" | grep -c .)
nothers=0; [ -z "$others" ] || nothers=$(printf '%s\n' "$others" | grep -c .)
room=$((max - nnew)); [ "$room" -gt 0 ] || room=0
{
    if [ "$nnew" -gt 0 ]; then
        if [ "$earlier" -gt 0 ]; then
            printf 'New custos findings in %s after this edit (%s reported earlier remain):\n' "$file" "$earlier"
        else
            printf 'custos findings in %s after this edit:\n' "$file"
        fi
        printf '%s\n' "$new" | head -n "$max" | cut -c 1-200
        [ "$nothers" -eq 0 ] || [ "$room" -eq 0 ] || printf 'In other files:\n'
    else
        printf 'New custos findings in other files after this edit of %s:\n' "$file"
    fi
    [ "$nothers" -eq 0 ] || [ "$room" -eq 0 ] || printf '%s\n' "$others" | head -n "$room" | cut -c 1-200
    if [ $((nnew + nothers)) -gt "$max" ]; then
        printf '... and %s more; run custos analyse to see them all.\n' "$((nnew + nothers - max))"
    fi
} | jq -Rs '{
  hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: .}
}'
