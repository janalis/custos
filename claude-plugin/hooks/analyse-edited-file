#!/bin/sh
# PostToolUse hook: after Claude edits a PHP file, run custos on that file and
# hand its findings back to Claude as additional context. Claude Code runs one
# language server per file extension, so this also works next to another PHP
# language server. It never blocks the edit: any failure exits 0 silently.
#
# The first edit of a file in a session reports all its findings; later edits
# report only the findings that were not there before. A finding is matched by
# its rule and message, without its position, since edits move lines.
#
# With CUSTOS_CROSS_FILE=1, it also analyses the whole project and reports the
# findings that appeared in other files since the previous edit, or since the
# start of the session (hooks/record-project).
command -v jq >/dev/null 2>&1 || exit 0
here=$(dirname "$0")
# shellcheck source-path=SCRIPTDIR source=../scripts/session-state
. "$here/../scripts/session-state"
custos=$here/../scripts/custos

input=$(cat) || exit 0
file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null) || exit 0
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
session=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null) || exit 0
case $file in *.php) ;; *) exit 0 ;; esac
# custos finds the project root from the working directory, as on the CLI.
if [ -n "$cwd" ]; then cd "$cwd" 2>/dev/null || exit 0; fi
case $file in /*) abs=$file ;; *) abs=$PWD/$file ;; esac
# Relative paths keep each finding line short.
case $file in "$PWD"/*) file=${file#"$PWD"/} ;; esac
[ -f "$file" ] || exit 0

# In a monorepo, the project of the edited file picks its Composer launcher.
out=$(CUSTOS_LAUNCHER_FROM=$(dirname "$file") "$custos" analyse --fail-on never -- "$file" 2>/dev/null) || exit 0
rows=$(printf '%s\n' "$out" | custos_rows)
cross=
if [ "${CUSTOS_CROSS_FILE:-}" = 1 ]; then
    project_rows=$(custos_project_findings "$custos") && cross=1
fi

# What was reported earlier in this session is kept in a private directory.
dir=
if custos_session_ok "$session" && base=$(custos_state_base) && mkdir -p "$base/$session" 2>/dev/null &&
    custos_lock "$base/$session"; then
    dir=$base/$session
    trap 'rmdir "$dir/lock" 2>/dev/null' EXIT
fi
if [ -n "$dir" ]; then
    state=$dir/$(printf '%s' "$abs" | cksum | tr ' ' -)
    result=$(printf '%s\n' "$rows" | custos_new_findings "$state" "")
    printf '%s\n' "$rows" > "$state.$$" && mv -f "$state.$$" "$state"
else
    result=$(printf '%s\n' "$rows" | custos_new_findings /dev/null "")
fi
nnew=$(printf '%s\n' "$result" | sed -n 1p)
new=$(printf '%s\n' "$result" | sed 1d)
earlier=$(($(printf '%s\n' "$rows" | grep -c .) - nnew))

# Findings in other files, the same way. Without project findings recorded for
# this directory, this edit only records them.
others=
if [ -n "$cross" ] && [ -n "$dir" ]; then
    project=$(custos_project_state "$dir")
    if [ -f "$project" ]; then
        others=$(printf '%s\n' "$project_rows" | custos_new_findings "$project" "$abs" | sed 1d)
    fi
    printf '%s\n' "$project_rows" > "$project.$$" && mv -f "$project.$$" "$project"
fi
[ -z "$dir" ] || rmdir "$dir/lock" 2>/dev/null
[ -n "$new" ] || [ -n "$others" ] || exit 0

# Claude Code cuts hook context above 10,000 characters to a short preview:
# send at most 40 lines of at most 200 characters each.
max=40
lnew=0; [ -z "$new" ] || lnew=$(printf '%s\n' "$new" | grep -c .)
lothers=0; [ -z "$others" ] || lothers=$(printf '%s\n' "$others" | grep -c .)
room=$((max - lnew)); [ "$room" -gt 0 ] || room=0
{
    if [ "$lnew" -gt 0 ]; then
        if [ "$earlier" -gt 0 ]; then
            printf 'New custos findings in %s after this edit (%s reported earlier remain):\n' "$file" "$earlier"
        else
            printf 'custos findings in %s after this edit:\n' "$file"
        fi
        printf '%s\n' "$new" | head -n "$max" | cut -c 1-200
        [ "$lothers" -eq 0 ] || [ "$room" -eq 0 ] || printf 'New in other files since the previous edit:\n'
    else
        printf 'New custos findings in other files since the previous edit, now that %s changed:\n' "$file"
    fi
    [ "$lothers" -eq 0 ] || [ "$room" -eq 0 ] || printf '%s\n' "$others" | head -n "$room" | cut -c 1-200
    if [ $((lnew + lothers)) -gt "$max" ]; then
        printf '... and %s more lines; run custos analyse to see them all.\n' "$((lnew + lothers - max))"
    fi
} | jq -Rs '{
  hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: .}
}'
