{
  "name": "custos",
  "description": "PHP inspections, quick-fixes and formatting from custos (language server and MCP tools)",
  "author": {
    "name": "The custos authors"
  },
  "homepage": "https://github.com/janalis/custos",
  "repository": "https://github.com/janalis/custos",
  "license": "MIT",
  "lspServers": {
    "custos": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/custos",
      "args": ["lsp"],
      "extensionToLanguage": {
        ".php": "php"
      }
    }
  },
  "mcpServers": {
    "custos": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/custos",
      "args": ["mcp"]
    }
  }
}
