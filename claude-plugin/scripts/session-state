# Shared by the hooks (sourced): the private session state, the findings as
# rows, and which of them are new.

# Print the per-user directory kept for session state, creating it; fail when
# it is not a private directory of the user's own.
custos_state_base() {
    _custos_base=${TMPDIR:-/tmp}/custos-claude-$(id -u)
    { mkdir -m 700 "$_custos_base" 2>/dev/null || [ -d "$_custos_base" ]; } || return 1
    [ ! -L "$_custos_base" ] || return 1
    [ -n "$(find "$_custos_base" -prune -user "$(id -u)" ! -perm -020 ! -perm -002)" ] || return 1
    printf '%s\n' "$_custos_base"
}

# Succeed for a session ID that is safe as a directory name.
custos_session_ok() {
    case $1 in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
}

# The project findings recorded for the working directory, in a session
# directory $1: Claude may change directory within a session.
custos_project_state() {
    printf '%s/project-%s\n' "$1" "$(printf '%s' "$PWD" | cksum | tr ' ' -)"
}

# Turn custos findings on stdin into rows of three tab-separated fields: the
# absolute path, the rule and message, and the finding as shown to Claude,
# with its path relative to the working directory when inside it.
custos_rows() {
    sed '/^$/,$d' | awk -v top="$PWD/" '
        match($0, /:[0-9]+:[0-9]+: /) {
            path = substr($0, 1, RSTART - 1)
            abs = (substr(path, 1, 1) == "/") ? path : (top path)
            shown = (index(abs, top) == 1) ? substr(abs, length(top) + 1) : abs
            print abs "\t" substr($0, RSTART + RLENGTH) "\t" shown substr($0, RSTART)
        }'
}

# Print the rows of the project, as configured in custos.json. $1 is the
# custos launcher. Fails when custos does not run.
custos_project_findings() {
    _custos_out=$("$1" analyse --fail-on never 2>/dev/null) || return 1
    printf '%s\n' "$_custos_out" | custos_rows
}

# Compare the rows on stdin with those in file $1 (missing: none before), by
# path, rule and message, since edits move lines; skip rows for path $2. Print
# the number of new findings, then the new findings. When a finding repeats
# and its count rose, positions cannot tell which occurrences are new: all of
# them are printed, after a line saying how many are new.
custos_new_findings() {
    awk -F '\t' -v prev="$1" -v skip="$2" '
        BEGIN { while ((getline line < prev) > 0) { split(line, f, "\t"); before[f[1] "\t" f[2]]++ } }
        NF && $1 != skip {
            k = $1 "\t" $2
            if (!(k in count)) order[++keys] = k
            count[k]++; shown[k] = shown[k] $3 "\n"
        }
        END {
            for (i = 1; i <= keys; i++) {
                k = order[i]; added = count[k] - before[k]
                if (added <= 0) continue
                total += added
                if (added < count[k]) out = out added " new among these " count[k] " identical findings:\n"
                out = out shown[k]
            }
            printf "%d\n%s", total, out
        }'
}

# Run the rest of the read, compare and write of session directory $1 alone:
# hooks of parallel edits wait for each other. A lock older than 2 minutes was
# left by a hook its timeout killed. Fails after about 30 seconds.
custos_lock() {
    _custos_tries=0
    while ! mkdir "$1/lock" 2>/dev/null; do
        if [ -n "$(find "$1/lock" -prune -mmin +2 2>/dev/null)" ]; then rmdir "$1/lock" 2>/dev/null; continue; fi
        _custos_tries=$((_custos_tries + 1))
        [ "$_custos_tries" -lt 30 ] || return 1
        sleep 1
    done
}
