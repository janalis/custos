#!/bin/sh
# Run custos from PATH. With CUSTOS_PROJECT_LAUNCHER=1, run the project's
# Composer launcher instead when it has one: vendor/bin/custos next to the
# nearest composer.json above the working directory. The search goes up no
# higher than the git root or the home directory, and outside the home
# directory it only looks at the working directory itself. The edit hook
# starts it instead from the edited file's directory (CUSTOS_LAUNCHER_FROM)
# when that is inside the working directory, and may then go up to it. That runs code from the
# repository, so it is off unless you turn it on.
if [ "${CUSTOS_PROJECT_LAUNCHER:-}" = 1 ]; then
    # Physical paths, so that symlinks and trailing slashes cannot hide HOME.
    home=$(cd "${HOME:-/nonexistent}" 2>/dev/null && pwd -P) || home=
    top=$(pwd -P 2>/dev/null) || top=
    dir=$(cd "${CUSTOS_LAUNCHER_FROM:-.}" 2>/dev/null && pwd -P) || dir=
    # A start outside the working directory, or in a dependency under a
    # vendor directory, falls back to the working directory. Without a
    # working directory, nothing is searched.
    case $dir/ in "$top"/*) ;; *) dir=$top ;; esac
    case ${dir#"$top"}/ in */vendor/*) dir=$top ;; esac
    [ -n "$top" ] || dir=
    while [ -n "$dir" ]; do
        # A git submodule or nested repository is another project.
        if [ "$dir" != "$top" ] && [ -e "$dir/.git" ]; then
            case $dir/ in "$top"/?*) dir=$top; continue ;; esac
        fi
        if [ -f "$dir/composer.json" ]; then
            if [ -x "$dir/vendor/bin/custos" ]; then exec "$dir/vendor/bin/custos" "$@"; fi
            break
        fi
        [ ! -e "$dir/.git" ] || break
        # Go up only from strictly inside the home or the working directory.
        up=
        case $home in ''|/) ;; *) case $dir/ in "$home"/?*) up=1 ;; esac ;; esac
        case $top in ''|/) ;; *) case $dir/ in "$top"/?*) up=1 ;; esac ;; esac
        [ -n "$up" ] || break
        dir=$(dirname "$dir")
    done
fi
if command -v custos >/dev/null 2>&1; then exec custos "$@"; fi
printf '%s\n' 'custos: not found; install it, or set CUSTOS_PROJECT_LAUNCHER=1 to use the project'"'"'s vendor/bin/custos.' >&2
exit 127
