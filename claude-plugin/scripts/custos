#!/bin/sh
# Run the custos of the project Claude Code works in: the Composer launcher
# (vendor/bin/custos) next to the nearest composer.json above the working
# directory when the project has one, else custos from PATH.
dir=$PWD
while :; do
    if [ -f "$dir/composer.json" ]; then
        if [ -x "$dir/vendor/bin/custos" ]; then exec "$dir/vendor/bin/custos" "$@"; fi
        break
    fi
    [ "$dir" != / ] || break
    dir=$(dirname "$dir")
done
if command -v custos >/dev/null 2>&1; then exec custos "$@"; fi
printf '%s\n' 'custos: not found; install it globally or with Composer (composer require --dev janalis/custos).' >&2
exit 127
