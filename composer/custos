#!/usr/bin/env php
<?php
// Composer launcher for custos: downloads the custos binary of this package's
// version for the current platform on first run (verified against the
// release's SHA256SUMS), caches it next to this file and runs it.
//
//   CUSTOS_BINARY        run this binary instead (no download)
//   CUSTOS_DOWNLOAD_URL  base URL or directory holding the release assets

namespace Custos\Launcher;

const VERSION = '0.1.6';
const RELEASES = 'https://github.com/janalis/custos/releases/download';

function fail(string $msg): void
{
    fwrite(STDERR, "custos: $msg\n");
    exit(2);
}

function asset(): string
{
    $os = ['Linux' => 'linux', 'Darwin' => 'darwin', 'Windows' => 'windows'][PHP_OS_FAMILY] ?? null;
    $machine = strtolower(php_uname('m'));
    $arch = ['x86_64' => 'amd64', 'amd64' => 'amd64', 'arm64' => 'arm64', 'aarch64' => 'arm64'][$machine] ?? null;
    if ($os === null || $arch === null) {
        fail('no prebuilt binary for ' . PHP_OS_FAMILY . "/$machine; build from source and set CUSTOS_BINARY");
    }
    return "custos_{$os}_{$arch}" . ($os === 'windows' ? '.exe' : '');
}

function fetch(string $url): string
{
    if (!preg_match('{^https?://}i', $url)) {
        $data = @file_get_contents($url);
        if ($data === false) {
            fail("cannot read $url");
        }
        return $data;
    }
    $http = ['user_agent' => 'custos-composer/' . VERSION, 'follow_location' => 1, 'timeout' => 60];
    $proxy = getenv('HTTPS_PROXY') ?: getenv('https_proxy');
    if ($proxy && ($p = parse_url($proxy)) && isset($p['host'])) {
        $http['proxy'] = 'tcp://' . $p['host'] . ':' . ($p['port'] ?? 80);
        $http['request_fulluri'] = true;
    }
    $data = @file_get_contents($url, false, stream_context_create(['http' => $http]));
    if ($data === false && function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => true, CURLOPT_FAILONERROR => true, CURLOPT_USERAGENT => $http['user_agent']]);
        $data = curl_exec($ch);
    }
    if (!is_string($data)) {
        fail("cannot download $url (set CUSTOS_DOWNLOAD_URL to a mirror, or CUSTOS_BINARY to a local binary)");
    }
    return $data;
}

function install(string $target): void
{
    $name = asset();
    $base = rtrim(getenv('CUSTOS_DOWNLOAD_URL') ?: RELEASES . '/v' . VERSION, '/');
    $want = null;
    foreach (explode("\n", fetch("$base/SHA256SUMS")) as $line) {
        $f = preg_split('{\s+\*?}', trim($line));
        if (count($f) === 2 && $f[1] === $name) {
            $want = strtolower($f[0]);
        }
    }
    if ($want === null) {
        fail("$name is not listed in $base/SHA256SUMS");
    }
    fwrite(STDERR, "custos: downloading $name " . VERSION . "\n");
    $bin = fetch("$base/$name");
    if (!hash_equals($want, hash('sha256', $bin))) {
        fail("checksum mismatch for $base/$name");
    }
    $dir = dirname($target);
    if (!is_dir($dir) && !@mkdir($dir, 0755, true) && !is_dir($dir)) {
        fail("cannot create $dir (set CUSTOS_BINARY to a local binary)");
    }
    $tmp = $target . '.' . getmypid() . '.tmp';
    if (@file_put_contents($tmp, $bin) !== strlen($bin) || !@chmod($tmp, 0755) || !@rename($tmp, $target)) {
        @unlink($tmp);
        fail("cannot write $target (set CUSTOS_BINARY to a local binary)");
    }
}

function absolutePath(string $path): bool
{
    return $path !== '' && ($path[0] === '/' || $path[0] === '\\'
        || (strlen($path) > 2 && preg_match('{^[A-Za-z]:}', $path)
            && ($path[2] === '/' || $path[2] === '\\')));
}

// Find the consuming project through Composer's proxy metadata or the invoked
// bin path. Verify its manifest and installed package target; never derive a
// workspace from the downloaded binary or this package's own composer.json.
function consumingRoot(string $package): ?string
{
    $candidates = [$_SERVER['argv'][0] ?? ''];
    if (isset($GLOBALS['_composer_autoload_path'])) {
        $candidates[] = $GLOBALS['_composer_autoload_path'];
    }
    if (isset($GLOBALS['_composer_bin_dir'])) {
        $candidates[] = $GLOBALS['_composer_bin_dir'];
    }
    foreach ($candidates as $candidate) {
        if ($candidate === '') {
            continue;
        }
        // Keep the lexical proxy path: realpath would lose symlinked installs.
        if (!absolutePath($candidate)) {
            $candidate = getcwd() . '/' . $candidate;
        }
        for ($dir = is_dir($candidate) ? $candidate : dirname($candidate); ; $dir = dirname($dir)) {
            $manifest = $dir . '/composer.json';
            if (is_file($manifest) && filesize($manifest) <= 8 * 1024 * 1024) {
                $project = json_decode(file_get_contents($manifest), true);
                if (is_array($project) && ($project['name'] ?? '') !== 'janalis/custos'
                    && (isset($project['require']['janalis/custos']) || isset($project['require-dev']['janalis/custos']))) {
                    $vendor = $project['config']['vendor-dir'] ?? 'vendor';
                    // An unusable vendor-dir keeps walking up; `continue` here
                    // would skip the filesystem-root check below.
                    $target = false;
                    if (is_string($vendor) && $vendor !== '' && strpos($vendor, "\0") === false) {
                        $vendorPath = absolutePath($vendor) ? $vendor : $dir . '/' . $vendor;
                        $target = realpath($vendorPath . '/janalis/custos/composer/custos');
                    }
                    if ($target !== false && $target === $package) {
                        // Composer's global home is not a consuming workspace.
                        $home = getenv('COMPOSER_HOME');
                        $globalHomes = array_filter([$home, getenv('HOME') . '/.composer', getenv('HOME') . '/.config/composer', getenv('HOME') . '/Library/Application Support/composer', getenv('XDG_CONFIG_HOME') ? getenv('XDG_CONFIG_HOME') . '/composer' : null, getenv('APPDATA') ? getenv('APPDATA') . '/Composer' : null]);
                        if (!in_array(realpath($dir), array_map('realpath', $globalHomes), true)) {
                            return realpath($dir) ?: null;
                        }
                    }
                }
            }
            if (dirname($dir) === $dir) {
                break;
            }
        }
    }
    return null;
}

// Composer's bin proxy includes this file through a stream wrapper.
$here = preg_replace('{^phpvfscomposer://}', '', __DIR__);
$bin = getenv('CUSTOS_BINARY');
if (!$bin) {
    $bin = $here . '/.bin/custos-' . VERSION . (PHP_OS_FAMILY === 'Windows' ? '.exe' : '');
    if (!is_file($bin)) {
        install($bin);
    }
}
// Only MCP consumes this hint; preserve cwd and all other command behavior.
if (($_SERVER['argv'][1] ?? '') === 'mcp') {
    $projectRoot = consumingRoot(realpath(preg_replace('{^phpvfscomposer://}', '', __FILE__)) ?: __FILE__);
    putenv($projectRoot === null ? 'CUSTOS_COMPOSER_ROOT' : 'CUSTOS_COMPOSER_ROOT=' . $projectRoot);
}
$proc = proc_open(array_merge([$bin], array_slice($_SERVER['argv'], 1)), [STDIN, STDOUT, STDERR], $pipes);
if (!is_resource($proc)) {
    fail("cannot run $bin");
}
exit(proc_close($proc));
